{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/dependency-graph.json-graph.v3.schema.json",
  "title": "DependencyGraph JSON Graph v3 (local SwiftPM targets and products)",
  "type": "object",
  "required": [
    "nodes",
    "edges",
    "metadata"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "schemaVersion",
        "format",
        "nodeCount",
        "edgeCount"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 3
        },
        "format": {
          "type": "string",
          "const": "json-graph"
        },
        "nodeCount": {
          "type": "integer",
          "minimum": 0
        },
        "edgeCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "type",
          "isTransient",
          "isInternal"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "project",
              "target",
              "localPackage",
              "externalPackage",
              "packageTarget",
              "packageProduct"
            ]
          },
          "isTransient": {
            "type": "boolean"
          },
          "isInternal": {
            "type": "boolean"
          },
          "package": {
            "type": "object",
            "properties": {
              "identity": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "revision": {
                "type": "string"
              },
              "branch": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "targetKind": {
            "type": "string",
            "description": "SwiftPM target type from the evaluated manifest (regular, test, binary, etc.)."
          }
        },
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "packageTarget"
                }
              }
            },
            "then": {
              "required": [
                "targetKind"
              ]
            }
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
